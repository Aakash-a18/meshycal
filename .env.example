# === MeshyCal configuration ===
# Copy this file to .env for local development. .env is gitignored.
# All required values MUST be set; the application fails fast at startup if
# any required variable is missing.

# --- Application ---
MESHYCAL_ENV=development                  # development | staging | production
MESHYCAL_LOG_LEVEL=info                   # debug | info | warning | error

# --- Tesherra connection ---
# The MeshyCal scheduling agent runs under each user's butler and reaches
# Tesherra through the local SDK. For demos, point at a local tesherra service.
TESHERRA_SDK_URL=http://localhost:8000
TESHERRA_API_KEY=replace-me

# --- Calendar source ---
# v0 demo uses synthetic data; OAuth integrations (Google, Apple, Microsoft)
# come later. Build discipline rule: no real user data in the repo.
MESHYCAL_CALENDAR_SOURCE=synthetic        # synthetic | google | apple | microsoft
MESHYCAL_SYNTHETIC_CALENDAR_PATH=./local-data/synthetic-calendar.json

# --- Scheduling defaults ---
# Default candidate slot window and slot duration. Overridden by user policy
# at runtime; these are the starting templates.
MESHYCAL_DEFAULT_LOOKAHEAD_DAYS=14
MESHYCAL_DEFAULT_SLOT_DURATION_MIN=30
MESHYCAL_DEFAULT_MAX_CANDIDATES=5

# --- Published schemas ---
# The publisher principal under which MeshyCal registers its Object classes
# (meshycal.scheduling/proposal-v1, counter-v1, accepted-v1, etc.) in the
# Tesherra Schema Registry. Identifies *this* MeshyCal install as the publisher.
MESHYCAL_SCHEMA_PUBLISHER_PRINCIPAL=meshycal-dev

# Tesherra Schema Registry endpoint. Must match TESHERRA_SCHEMA_REGISTRY_URL
# of the Tesherra service this MeshyCal install connects to (typically the
# same value as TESHERRA_SDK_URL above, since the Registry is part of the
# Tesherra service in v0).
MESHYCAL_SCHEMA_REGISTRY_URL=http://localhost:8000
